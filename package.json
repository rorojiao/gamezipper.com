{
  "scripts": {
    "audit:adsense": "node scripts/audit-adsense.mjs",
    "test:wishes": "node --test tests/wish-wall.test.mjs tests/wish-wall-ui.test.mjs",
    "test:wishes:worker": "node --test tests/wish-worker-integration.test.mjs",
    "test:wishes:production:api": "node tests/wish-production-smoke.mjs",
    "test:wishes:production:ui": "node tests/wish-production-ui.mjs",
    "server:dev": "node server/index.js",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:migrate:local": "wrangler d1 migrations apply gamezipper-wishes --local --config worker/wrangler.toml",
    "worker:migrate:remote": "wrangler d1 migrations apply gamezipper-wishes --remote --config worker/wrangler.toml"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "wrangler": "^4.49.0"
  }
}
