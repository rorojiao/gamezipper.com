# Local-only example. Never commit real secrets.
# Configure Worker secrets with: npx wrangler secret put <NAME> --config worker/wrangler.toml

WISH_ADMIN_PASSWORD=replace-with-a-long-random-password
RESEND_API_KEY=re_replace_me
WISH_EMAIL_TO=you@example.com
WISH_EMAIL_FROM="GameZipper Wishes <wishes@your-verified-domain.com>"

# Optional Cloudflare Turnstile. Set the public site key in worker/wrangler.toml.
TURNSTILE_SECRET_KEY=

# Local Wrangler only: permits the local static-site preview to call the Worker.
# WISH_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
