# Local example only. Production values are injected through CapRover environment variables.
PORT=8080
WISH_DB_PATH=./data/wishes.db
WISH_ADMIN_PASSWORD=replace-with-a-long-random-password
WISH_ALLOWED_ORIGINS=https://gamezipper.com,https://www.gamezipper.com
WISH_ADMIN_URL=https://gamezipper.com/admin/wishes/
WISH_EMAIL_TO=admin@example.com
WISH_EMAIL_FROM="GameZipper Wishes <wishes@example.com>"
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=wishes@example.com
SMTP_PASS=replace-me
SMTP_VERIFY_ON_START=true
